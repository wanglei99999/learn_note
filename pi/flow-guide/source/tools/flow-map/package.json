{
  "name": "flow-map-tools",
  "private": true,
  "type": "module",
  "description": "把 markdown 里的 mermaid 流程图生成可导览的查看页",
  "scripts": {
    "check": "node check.mjs ../../pi-flow-map.md",
    "build": "node make-viewer.mjs ../../pi-flow-map.md ../../pi-flow-map.html \"pi 全流程总图\""
  },
  "devDependencies": {
    "highlight.js": "11.12.0",
    "jsdom": "24.1.3",
    "marked": "18.0.12",
    "mermaid": "11.17.2"
  }
}
